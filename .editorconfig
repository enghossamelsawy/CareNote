# Shared formatting rules for editors and ktlint: ./gradlew ktlintCheck / ktlintFormat
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
# Trailing commas, as the Kotlin coding conventions recommend: adding an argument changes one line only.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Import order is left to the IDE's "Optimize Imports"; unused and wildcard imports are still checked.
ktlint_standard_import-ordering = disabled
# Composables are named like types (ResidentsScreen), which ktlint's function naming rule would reject.
ktlint_function_naming_ignore_when_annotated_with = Composable
# The design system's own theme extensions; any other CompositionLocal needs a reason to be added here.
compose_allowed_composition_locals = LocalSpacing,LocalDimens,LocalStatusColors,LocalAvatarColors

[*.md]
trim_trailing_whitespace = false
