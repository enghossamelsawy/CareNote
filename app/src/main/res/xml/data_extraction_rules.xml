<?xml version="1.0" encoding="utf-8"?>
<!--
    Residents' names, notes and vital signs are health data: they stay on this phone and leave it only
    through the app's own sync. allowBackup="false" stops cloud backup, but on Android 12 and newer only
    these rules also stop device-to-device transfer, so every domain is excluded from both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
